def _media_label(msg) -> str:
    if msg.photo:    return "📷 [Foto]"
    if msg.video:    return "🎥 [Video]"
    if msg.voice:    return "🎤 [Voice Note]"
    if msg.document: return "📎 [Dokumen]"
    if msg.sticker:  return "🎨 [Sticker]"
    if msg.audio:    return "🎵 [Audio]"
    return "📎 [Media]"


async def query_antrean(target_uid: int):
    bot_username = get_bot_antrean()

    try:
        bot_entity = await client.get_entity(bot_username)
    except Exception as e:
        return False, "", [], f"Bot {bot_username} tidak ditemukan ({type(e).__name__}). Pastikan userbot sudah /start ke bot ini."

    try:
        last_msgs = await client.get_messages(bot_entity, limit=1)
        last_id = last_msgs[0].id if last_msgs else 0
    except Exception:
        last_id = 0

    try:
        await client.send_message(bot_entity, f"/queue {target_uid}")
    except FloodWaitError as e:
        return False, "", [], f"FloodWait {e.seconds}s saat kirim ke bot"
    except Exception as e:
        return False, "", [], f"Gagal kirim ke bot: {type(e).__name__}"

    try:
        await client.wait_for(
            events.NewMessage(from_users=bot_entity, chats=bot_entity),
            timeout=QUEUE_TIMEOUT,
        )
    except asyncio.TimeoutError:
        return False, "", [], f"Bot tidak merespons dalam {QUEUE_TIMEOUT} detik"
    except Exception as e:
        return False, "", [], f"Error wait_for: {type(e).__name__}"

    await asyncio.sleep(2)

    new_msgs = []
    try:
        async for msg in client.iter_messages(bot_entity, min_id=last_id, from_user=bot_entity):
            new_msgs.append(msg)
        new_msgs.reverse()
    except Exception as e:
        return False, "", [], f"Gagal ambil respons: {type(e).__name__}"

    if not new_msgs:
        return False, "", [], "Bot tidak mengirim pesan apapun"

    parts = [msg.raw_text if msg.raw_text else _media_label(msg) for msg in new_msgs]
    combined = "\n\n".join(p for p in parts if p)
    return True, combined, new_msgs, None


