        except Exception as e:
            await event.edit(f"❌ Gagal: <code>{type(e).__name__}</code>", parse_mode='html')

    elif re.match(r"^\.akhiri\s+(\d+)$", text):
        uid = int(re.match(r"^\.akhiri\s+(\d+)$", text).group(1))
        if is_blocked(uid):
