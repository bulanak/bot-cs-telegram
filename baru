        await event.edit(
            f"✅ <b>PERCAKAPAN DIAKHIRI</b>\n"
            "━━━━━━━━━━━━━━━━━━━━━━\n"
            f"🆔 <b>User ID</b>       : <code>{uid}</code>\n"
            f"📩 <b>Pesan penutup</b> : Terkirim ✅\n"
            f"📌 <b>Unpin kartu</b>   : {unpin_status}\n"
            "━━━━━━━━━━━━━━━━━━━━━━\n\n"
            "<i>Percakapan dengan user ini resmi selesai.</i>",
            parse_mode='html'
        )

    elif re.match(r"^\.bisukan\s+(\d+)$", text):
        uid = int(re.match(r"^\.bisukan\s+(\d+)$", text).group(1))
        mute_user(uid)
        await event.edit(f"🔕 <b>USER DIBISUKAN</b>\n\n🆔 <code>{uid}</code>\n\n<i>Auto-reply dinonaktifkan.</i>", parse_mode='html')

    elif re.match(r"^\.suara\s+(\d+)$", text):
        uid = int(re.match(r"^\.suara\s+(\d+)$", text).group(1))
        unmute_user(uid)
        await event.edit(f"🔔 <b>USER DIAKTIFKAN KEMBALI</b>\n\n🆔 <code>{uid}</code>", parse_mode='html')

    elif re.match(r"^\.blok\s+(\d+)(?:\s+(.+))?$", text):
        m = re.match(r"^\.blok\s+(\d+)(?:\s+(.+))?$", text)
        uid = int(m.group(1)); reason = (m.group(2) or "").strip()
        block_user(uid, reason)
        await event.edit(
            f"🚫 <b>USER DIBLOKIR</b>\n\n🆔 <code>{uid}</code>\n"
            f"📝 Alasan: {html.escape(reason) if reason else '(tidak ada)'}\n\n"
            f"Buka: <code>.unblok {uid}</code>",
            parse_mode='html'
        )

    elif re.match(r"^\.unblok\s+(\d+)$", text):
        uid = int(re.match(r"^\.unblok\s+(\d+)$", text).group(1))
        unblock_user(uid)
        await event.edit(f"✅ <b>USER DIBUKA BLOKIRNYA</b>\n\n🆔 <code>{uid}</code>", parse_mode='html')

    elif text == '.listbisukan':
        users = list_muted()
        if not users:
            await event.edit("📭 Tidak ada user yang dibisukan.", parse_mode='html'); return
        lines = [f"🔕 <b>DAFTAR BISUKAN ({len(users)})</b>", "━━━━━━━━━━━━━━━━━━━━━━"]
        for uid in users: lines.append(f"• <code>{uid}</code>")
        await event.edit("\n".join(lines), parse_mode='html')

    elif text == '.listblok':
        users = list_blocked()
        if not users:
            await event.edit("📭 Tidak ada user yang diblokir.", parse_mode='html'); return
        lines = [f"🚫 <b>DAFTAR BLOKIR ({len(users)})</b>", "━━━━━━━━━━━━━━━━━━━━━━"]
        for uid, reason in users:
            r = f" — {html.escape(reason)}" if reason else ""
            lines.append(f"• <code>{uid}</code>{r}")
        await event.edit("\n".join(lines), parse_mode='html')

    elif re.match(r"^\.setbotantrean\s+(@?\w+)$", text):
        m = re.match(r"^\.setbotantrean\s+(@?\w+)$", text)
        set_bot_antrean(m.group(1))
        await event.edit(
            f"✅ <b>Bot antrean diset</b>\n\n🤖 {get_bot_antrean()}\n\n"
            f"Coba: <code>.cekantrean 123456789</code>",
            parse_mode='html'
        )

    elif re.match(r"^\.cekantrean(?:\s+(\d+))?$", text):
        m = re.match(r"^\.cekantrean(?:\s+(\d+))?$", text)
        target_uid = int(m.group(1)) if m.group(1) else None
        if target_uid is None and event.reply_to_msg_id:
            target_uid = get_user_from_report(event.reply_to_msg_id)
        if target_uid is None:
            await event.edit(
                "⚠️ <b>Format salah</b>\n\n"
                "• <code>.cekantrean 123456789</code>\n"
                "• Reply pesan laporan lalu ketik <code>.cekantrean</code>\n\n"
                f"🤖 Bot aktif: {get_bot_antrean()}\n"
                "Ubah: <code>.setbotantrean @username</code>",
                parse_mode='html'
            ); return
        if is_blocked(target_uid):
            await event.edit(f"🚫 User <code>{target_uid}</code> diblokir.", parse_mode='html'); return

        bot_name = get_bot_antrean()
        async with _cekantrean_lock:
            await event.edit(
                f"⏳ <b>MENGECEK ANTREAN</b>\n"
                "━━━━━━━━━━━━━━━━━━━━━━\n"
                f"🆔 User   : <code>{target_uid}</code>\n"
                f"🤖 Bot    : {bot_name}\n"
                f"⏱️ Timeout: {QUEUE_TIMEOUT}s\n"
                "━━━━━━━━━━━━━━━━━━━━━━\n\n"
                "<i>Mengirim perintah ke bot antrean...</i>",
                parse_mode='html'
            )
            ok, result_text, new_msgs, error = await query_antrean(target_uid)

            if not ok:
                await event.edit(
                    f"❌ <b>GAGAL CEK ANTREAN</b>\n"
                    "━━━━━━━━━━━━━━━━━━━━━━\n"
                    f"🆔 User  : <code>{target_uid}</code>\n"
                    f"🤖 Bot   : {bot_name}\n"
                    f"⚠️ Error : <code>{html.escape(str(error))}</code>\n"
                    "━━━━━━━━━━━━━━━━━━━━━━\n\n"
                    "<i>💡 Pastikan userbot sudah /start ke bot antrean.</i>",
                    parse_mode='html'
                ); return

            forward_status = "✅ Terkirim"
            try:
                waktu = datetime.now().strftime('%d %b %Y • %H:%M')
                header = (
                    "📋 <b>HASIL CEK ANTREAN</b>\n"
                    "━━━━━━━━━━━━━━━━━━━━━━\n"
                    f"🆔 <b>User ID</b> : <code>{target_uid}</code>\n"
                    f"🕐 <b>Waktu</b>   : {waktu}\n"
                    "━━━━━━━━━━━━━━━━━━━━━━\n\n"
                )
                await client.send_message(target_uid, header + result_text, parse_mode='html')
                bot_entity = await client.get_entity(bot_name)
                for msg in new_msgs:
                    if msg.media and not msg.raw_text:
                        try:
                            await client.forward_messages(target_uid, msg, from_peer=bot_entity)
                            await asyncio.sleep(0.5)
                        except Exception as m_err:
                            log.warning(f"[CEKANTREAN MEDIA] {m_err}")
            except FloodWaitError as e:
                forward_status = f"⏳ FloodWait {e.seconds}s"
            except Exception as e:
                forward_status = f"⚠️ {type(e).__name__}"
                log.error(f"[CEKANTREAN FWD] {e}")

            preview = result_text[:800] + ("…" if len(result_text) > 800 else "")
            await event.edit(
                f"✅ <b>CEK ANTREAN SELESAI</b>\n"
                "━━━━━━━━━━━━━━━━━━━━━━\n"
                f"🆔 User          : <code>{target_uid}</code>\n"
                f"🤖 Bot           : {bot_name}\n"
                f"📨 Kirim ke user : {forward_status}\n"
                "━━━━━━━━━━━━━━━━━━━━━━\n\n"
                f"<b>Hasil:</b>\n<blockquote>{html.escape(preview)}</blockquote>",
                parse_mode='html'
            )

    elif re.match(r"^\.set\s+t(\d{1,2})\s+([\s\S]+)$", text):
        m = re.match(r"^\.set\s+t(\d{1,2})\s+([\s\S]+)$", text)
        n = int(m.group(1))
        if not (1 <= n <= MAX_TEMPLATE):
            await event.edit(f"⚠️ Nomor template hanya 1–{MAX_TEMPLATE}."); return
        key = f"t{n}"; content = m.group(2).strip()
        upsert_template_text(key, content)
        preview = html.escape(content[:300]) + ("…" if len(content) > 300 else "")
        await event.edit(f"✅ <b>Template {key} disimpan</b>\n\n<blockquote>{preview}</blockquote>", parse_mode='html')

    elif re.match(r"^\.setgambar\s+t(\d{1,2})$", text):
        n = int(re.match(r"^\.setgambar\s+t(\d{1,2})$", text).group(1))
        if not (1 <= n <= MAX_TEMPLATE):
            await event.edit(f"⚠️ Nomor template hanya 1–{MAX_TEMPLATE}."); return
        key = f"t{n}"
        if not event.reply_to_msg_id:
            await event.edit(f"⚠️ Reply ke foto dulu, lalu kirim <code>.setgambar {key}</code>", parse_mode='html'); return
        replied = await event.get_reply_message()
        if not replied or not replied.media:
            await event.edit("⚠️ Pesan yang di-reply bukan gambar/media."); return
        await event.edit(f"⏳ Mengunduh media untuk <b>{key}</b>...", parse_mode='html')
        try:
            ext = ".jpg"
            if replied.document and replied.document.mime_type:
                mt = replied.document.mime_type
                if "png" in mt: ext = ".png"
                elif "gif" in mt: ext = ".gif"
                elif "mp4" in mt: ext = ".mp4"
                elif "webp" in mt: ext = ".webp"
            for old in MEDIA_DIR.glob(f"{key}.*"):
                try: old.unlink()
                except: pass
            file_path = str(MEDIA_DIR / f"{key}{ext}")
            await client.download_media(replied, file=file_path)
            upsert_template_media(key, file_path)
            await event.edit(
                f"✅ <b>Gambar disimpan ke {key}</b>\n\n📁 <code>{file_path}</code>\n\n"
                f"Ketik <code>.{key}</code> untuk kirim.",
                parse_mode='html'
            )
        except Exception as e:
            log.error(f"[SETGAMBAR] {e}")
            await event.edit(f"❌ Gagal download: <code>{html.escape(str(e))}</code>", parse_mode='html')

    elif re.match(r"^\.delgambar\s+t(\d{1,2})$", text):
        n = int(re.match(r"^\.delgambar\s+t(\d{1,2})$", text).group(1))
        if not (1 <= n <= MAX_TEMPLATE): return
        key = f"t{n}"
        clear_template_media(key)
        await event.edit(f"✅ Gambar pada <code>{key}</code> dihapus.", parse_mode='html')

    elif re.match(r"^\.del\s+t(\d{1,2})$", text):
        n = int(re.match(r"^\.del\s+t(\d{1,2})$", text).group(1))
        if not (1 <= n <= MAX_TEMPLATE): return
        key = f"t{n}"
        delete_template(key)
        await event.edit(f"🗑️ Template <code>{key}</code> dihapus.", parse_mode='html')

    elif text == '.listt':
        rows = list_all_templates()
        if not rows:
            await event.edit("📭 Belum ada template.\n\nBuat: <code>.set t1 Halo Kak...</code>", parse_mode='html'); return
        lines = ["📋 <b>DAFTAR TEMPLATE</b>", "━━━━━━━━━━━━━━━━━━━━━━"]
        for key, content, file_path in rows:
            has_media = "🖼️" if (file_path and os.path.exists(file_path)) else "📝"
            preview = (content or "(tanpa teks)").replace("\n", " ")
            if len(preview) > 60: preview = preview[:60] + "…"
            lines.append(f"{has_media} <b>{key}</b> → {html.escape(preview)}")
        lines.append("━━━━━━━━━━━━━━━━━━━━━━")
        lines.append("💡 Ketik <code>.t1</code> … <code>.t10</code> untuk kirim.")
        await event.edit("\n".join(lines), parse_mode='html')

    elif re.match(r"^\.t(\d{1,2})(?:\s+(\d+))?$", text):
        m = re.match(r"^\.t(\d{1,2})(?:\s+(\d+))?$", text)
        n = int(m.group(1))
        explicit_target = int(m.group(2)) if m.group(2) else None
        if not (1 <= n <= MAX_TEMPLATE):
            await event.edit(f"⚠️ Template hanya 1–{MAX_TEMPLATE}."); return
        key = f"t{n}"
        tmpl = get_template(key)
        if not tmpl:
            await event.edit(
                f"⚠️ Template <code>{key}</code> belum ada.\nSet: <code>.set {key} Teks</code>",
                parse_mode='html'
            ); return
        if event.is_private and explicit_target is None:
            if is_blocked(event.chat_id):
                await event.edit("🚫 User ini diblokir."); return
            text_content, file_path = tmpl
            if file_path and os.path.exists(file_path):
                await event.delete()
                ok, err = await send_template(event.chat_id, key)
                if not ok:
                    await client.send_message(event.chat_id, f"❌ Gagal: {err}")
            else:
                await event.edit(text_content or "")
            return
        target = explicit_target
        if target is None and event.is_group and event.reply_to_msg_id:
            target = get_user_from_report(event.reply_to_msg_id)
        if target is None:
            await event.edit(
                "⚠️ <b>Target tidak diketahui.</b>\n\n"
                "• Chat pribadi → <code>.t1</code>\n"
                "• Reply laporan → <code>.t1</code>\n"
                "• Manual → <code>.t1 123456789</code>",
                parse_mode='html'
            ); return
        ok, err = await send_template(target, key)
        if ok:
            await event.edit(f"✅ Template <code>{key}</code> terkirim ke <code>{target}</code>", parse_mode='html')
        else:
            await event.edit(f"❌ <b>Gagal kirim:</b>\n<code>{html.escape(str(err))}</code>", parse_mode='html')


