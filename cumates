# 1. COMMAND ADMIN
# =========================================================
@client.on(events.NewMessage(outgoing=True))
async def owner_commands(event):
    text = event.raw_text.strip()

    # ── .admin NamaBaru ────────────────────────────────
    if text.startswith('.admin '):
        nama_baru = text.split('.admin ', 1)[1].strip()
        if nama_baru:
            update_setting('nama_admin', nama_baru)
            await event.edit(f"✅ Nama admin CS: <b>{nama_baru}</b>", parse_mode='html')
        else:
            await event.edit("⚠️ Format: <code>.admin NamaAdmin</code>", parse_mode='html')

    # ── .open / .close / .status ───────────────────────
    elif text == '.open':
        update_setting('is_store_open', 'True')
        await event.edit("🟢 <b>STATUS CS: BUKA</b>", parse_mode='html')

    elif text == '.close':
        update_setting('is_store_open', 'False')
        await event.edit("🔴 <b>STATUS CS: TUTUP</b>", parse_mode='html')

    elif text == '.status':
        nama_aktif = get_setting('nama_admin')
        is_open    = get_setting('is_store_open') == 'True'
        status     = "🟢 BUKA" if is_open else "🔴 TUTUP"
        total_user = len(_memory_users) or _count_users()
        await event.edit(
            "📊 <b>STATUS CS</b>\n"
            "━━━━━━━━━━━━━━━━━━━━━━\n"
            f"👩‍💼 <b>Admin</b>     : {nama_aktif}\n"
            f"🏪 <b>Status</b>    : {status}\n"
            f"👥 <b>Pelanggan</b> : {total_user}\n"
            f"🔕 <b>Bisukan</b>   : {len(_muted_cache)}\n"
            f"🚫 <b>Blokir</b>    : {len(_blocked_cache)}\n"
            "━━━━━━━━━━━━━━━━━━━━━━\n"
            "💡 <b>Perintah:</b>\n"
            "<code>.admin Nama</code> · <code>.open</code> · <code>.close</code> · <code>.status</code>\n"
            "<code>.terhubung USER_ID</code>\n"
            "<code>.bisukan USER_ID</code> · <code>.suara USER_ID</code>\n"
            "<code>.blok USER_ID [alasan]</code> · <code>.unblok USER_ID</code>\n"
            "<code>.listbisukan</code> · <code>.listblok</code>\n\n"
            "📨 <b>Template:</b>\n"
            "<code>.set t1 Teks</code> · <code>.setgambar t1</code> (reply foto)\n"
            "<code>.delgambar t1</code> · <code>.del t1</code> · <code>.listt</code>\n"
            "<code>.t1</code> … <code>.t10</code> → kirim balasan cepat",
            parse_mode='html'
        )

    # ── .terhubung USER_ID ─────────────────────────────
    elif text.startswith('.terhubung '):
        arg = text.split('.terhubung ', 1)[1].strip()
        if not arg.isdigit():
            await event.edit("⚠️ Format: <code>.terhubung 123456789</code>", parse_mode='html')
            return

        target_user_id = int(arg)

        if is_blocked(target_user_id):
            await event.edit(
                f"🚫 User <code>{target_user_id}</code> sedang diblokir.\n"
                f"Buka dulu dengan <code>.unblok {target_user_id}</code>",
                parse_mode='html'
            )
            return

        nama_aktif = get_setting('nama_admin')
        try:
            target_user = await client.get_entity(target_user_id)
        except Exception:
            target_user = None

        try:
            sent = await client.send_message(
                target_user_id,
                msg_connected(nama_aktif, user=target_user, user_id=target_user_id),
                parse_mode='html',
                buttons=keyboard_connected(target_user_id),
            )
            try:
                await client.pin_message(target_user_id, sent.id, notify=True)
            except Exception as pin_err:
                log.warning(f"[PIN] {pin_err}")

            await event.edit(
                f"✅ <b>TERHUBUNG + PIN</b>\n"
                f"🆔 <code>{target_user_id}</code>\n"
                f"👩‍💼 {nama_aktif}",
                parse_mode='html'
            )
        except Exception as e:
            await event.edit(f"❌ Gagal: <code>{type(e).__name__}</code>", parse_mode='html')

    # ── .bisukan USER_ID ───────────────────────────────
    elif re.match(r"^\.bisukan\s+(\d+)$", text):
        uid = int(re.match(r"^\.bisukan\s+(\d+)$", text).group(1))
        mute_user(uid)
        await event.edit(
            f"🔕 <b>USER DIBISUKAN</b>\n\n"
            f"🆔 <code>{uid}</code>\n\n"
            f"Bot tidak akan auto-reply ke user ini, tapi admin masih bisa manual chat.\n"
            f"Buka dengan <code>.suara {uid}</code>",
            parse_mode='html'
        )

    # ── .suara USER_ID ─────────────────────────────────
    elif re.match(r"^\.suara\s+(\d+)$", text):
        uid = int(re.match(r"^\.suara\s+(\d+)$", text).group(1))
        unmute_user(uid)
        await event.edit(
            f"🔔 <b>USER DIAKTIFKAN KEMBALI</b>\n\n🆔 <code>{uid}</code>",
            parse_mode='html'
        )

    # ── .blok USER_ID [alasan] ─────────────────────────
    elif re.match(r"^\.blok\s+(\d+)(?:\s+(.+))?$", text):
        m = re.match(r"^\.blok\s+(\d+)(?:\s+(.+))?$", text)
        uid = int(m.group(1))
        reason = (m.group(2) or "").strip()
        block_user(uid, reason)
        await event.edit(
            f"🚫 <b>USER DIBLOKIR</b>\n\n"
            f"🆔 <code>{uid}</code>\n"
            f"📝 Alasan: {html.escape(reason) if reason else '(tidak ada)'}\n\n"
            f"Pesan dari user ini akan diabaikan.\n"
            f"Buka dengan <code>.unblok {uid}</code>",
            parse_mode='html'
        )

    # ── .unblok USER_ID ────────────────────────────────
    elif re.match(r"^\.unblok\s+(\d+)$", text):
        uid = int(re.match(r"^\.unblok\s+(\d+)$", text).group(1))
        unblock_user(uid)
        await event.edit(
            f"✅ <b>USER DIBUKA BLOKIRNYA</b>\n\n🆔 <code>{uid}</code>",
            parse_mode='html'
        )

    # ── .listbisukan ───────────────────────────────────
    elif text == '.listbisukan':
        users = list_muted()
        if not users:
            await event.edit("📭 Tidak ada user yang dibisukan.", parse_mode='html')
            return
        lines = [f"🔕 <b>DAFTAR BISUKAN ({len(users)})</b>", "━━━━━━━━━━━━━━━━━━━━━━"]
        for uid in users:
            lines.append(f"• <code>{uid}</code>")
        await event.edit("\n".join(lines), parse_mode='html')

    # ── .listblok ──────────────────────────────────────
    elif text == '.listblok':
        users = list_blocked()
        if not users:
            await event.edit("📭 Tidak ada user yang diblokir.", parse_mode='html')
            return
        lines = [f"🚫 <b>DAFTAR BLOKIR ({len(users)})</b>", "━━━━━━━━━━━━━━━━━━━━━━"]
        for uid, reason in users:
            r = f" — {html.escape(reason)}" if reason else ""
            lines.append(f"• <code>{uid}</code>{r}")
        await event.edit("\n".join(lines), parse_mode='html')

    # =================================================
    # TEMPLATE SYSTEM
    # =================================================

    # ── .set t1 Teks ───────────────────────────────────
    elif re.match(r"^\.set\s+t(\d{1,2})\s+([\s\S]+)$", text):
        m = re.match(r"^\.set\s+t(\d{1,2})\s+([\s\S]+)$", text)
        n = int(m.group(1))
        if not (1 <= n <= MAX_TEMPLATE):
            await event.edit(f"⚠️ Nomor template hanya 1–{MAX_TEMPLATE}.")
            return
        key = f"t{n}"
        content = m.group(2).strip()
        upsert_template_text(key, content)
        preview = html.escape(content[:300]) + ("…" if len(content) > 300 else "")
        await event.edit(
            f"✅ <b>Template {key} disimpan</b>\n\n<blockquote>{preview}</blockquote>",
            parse_mode='html'
        )

    # ── .setgambar t1 (reply foto) ─────────────────────
    elif re.match(r"^\.setgambar\s+t(\d{1,2})$", text):
        n = int(re.match(r"^\.setgambar\s+t(\d{1,2})$", text).group(1))
        if not (1 <= n <= MAX_TEMPLATE):
            await event.edit(f"⚠️ Nomor template hanya 1–{MAX_TEMPLATE}.")
            return
        key = f"t{n}"

        if not event.reply_to_msg_id:
            await event.edit(
                f"⚠️ <b>Reply ke foto</b> dulu, lalu kirim <code>.setgambar {key}</code>",
                parse_mode='html'
            )
            return

        replied = await event.get_reply_message()
        if not replied or not replied.media:
            await event.edit("⚠️ Pesan yang di-reply bukan gambar/media.")
            return

        await event.edit(f"⏳ Mengunduh media untuk <b>{key}</b>...", parse_mode='html')
        try:
            ext = ".jpg"
            if replied.document and replied.document.mime_type:
                mt = replied.document.mime_type
                if "png" in mt: ext = ".png"
                elif "gif" in mt: ext = ".gif"
                elif "mp4" in mt: ext = ".mp4"
                elif "webp" in mt: ext = ".webp"

            for old in MEDIA_DIR.glob(f"{key}.*"):
                try: old.unlink()
                except: pass

            file_path = str(MEDIA_DIR / f"{key}{ext}")
            await client.download_media(replied, file=file_path)
            upsert_template_media(key, file_path)

            await event.edit(
                f"✅ <b>Gambar disimpan ke {key}</b>\n\n"
                f"📁 <code>{file_path}</code>\n\n"
                f"Ketik <code>.{key}</code> → gambar + caption otomatis terkirim.",
                parse_mode='html'
            )
        except Exception as e:
            log.error(f"[SETGAMBAR] {e}")
            await event.edit(f"❌ Gagal download: <code>{html.escape(str(e))}</code>", parse_mode='html')

    # ── .delgambar t1 ──────────────────────────────────
    elif re.match(r"^\.delgambar\s+t(\d{1,2})$", text):
        n = int(re.match(r"^\.delgambar\s+t(\d{1,2})$", text).group(1))
        if not (1 <= n <= MAX_TEMPLATE):
            return
        key = f"t{n}"
        clear_template_media(key)
        await event.edit(f"✅ Gambar pada <code>{key}</code> dihapus.", parse_mode='html')

    # ── .del t1 ────────────────────────────────────────
    elif re.match(r"^\.del\s+t(\d{1,2})$", text):
        n = int(re.match(r"^\.del\s+t(\d{1,2})$", text).group(1))
        if not (1 <= n <= MAX_TEMPLATE):
            return
        key = f"t{n}"
        delete_template(key)
        await event.edit(f"🗑️ Template <code>{key}</code> dihapus.", parse_mode='html')

    # ── .listt ─────────────────────────────────────────
    elif text == '.listt':
        rows = list_all_templates()
        if not rows:
            await event.edit(
                "📭 Belum ada template.\n\nBuat dengan: <code>.set t1 Halo Kak...</code>",
                parse_mode='html'
            )
            return

        lines = ["📋 <b>DAFTAR TEMPLATE</b>", "━━━━━━━━━━━━━━━━━━━━━━"]
        for key, content, file_path in rows:
            has_media = "🖼️" if (file_path and os.path.exists(file_path)) else "📝"
            preview = (content or "(tanpa teks)").replace("\n", " ")
            if len(preview) > 60:
                preview = preview[:60] + "…"
            lines.append(f"{has_media} <b>{key}</b> → {html.escape(preview)}")
        lines.append("━━━━━━━━━━━━━━━━━━━━━━")
        lines.append("💡 Ketik <code>.t1</code> … <code>.t10</code> untuk kirim.")
        await event.edit("\n".join(lines), parse_mode='html')

    # ── .t1 … .t10 [USER_ID] ───────────────────────────
    elif re.match(r"^\.t(\d{1,2})(?:\s+(\d+))?$", text):
        m = re.match(r"^\.t(\d{1,2})(?:\s+(\d+))?$", text)
        n = int(m.group(1))
        explicit_target = int(m.group(2)) if m.group(2) else None

        if not (1 <= n <= MAX_TEMPLATE):
            await event.edit(f"⚠️ Template hanya 1–{MAX_TEMPLATE}.")
            return
        key = f"t{n}"

        tmpl = get_template(key)
        if not tmpl:
            await event.edit(
                f"⚠️ Template <code>{key}</code> belum ada.\n"
                f"Set: <code>.set {key} Teks balasan</code>",
                parse_mode='html'
            )
            return

        # KASUS 1: chat pribadi pelanggan
        if event.is_private and explicit_target is None:
            if is_blocked(event.chat_id):
                await event.edit("🚫 User ini diblokir.")
                return
            text_content, file_path = tmpl
            if file_path and os.path.exists(file_path):
                await event.delete()
                ok, err = await send_template(event.chat_id, key)
                if not ok:
                    await client.send_message(event.chat_id, f"❌ Gagal: {err}")
            else:
                await event.edit(text_content or "")
            return

        # KASUS 2 & 3: butuh target
        target = explicit_target
        if target is None and event.is_group and event.reply_to_msg_id:
            target = get_user_from_report(event.reply_to_msg_id)

        if target is None:
            await event.edit(
                "⚠️ <b>Target tidak diketahui.</b>\n\n"
                "Cara pakai:\n"
                "• Chat pribadi pelanggan → <code>.t1</code>\n"
                "• Reply pesan laporan di grup → <code>.t1</code>\n"
                "• Manual → <code>.t1 123456789</code>",
                parse_mode='html'
            )
            return

        ok, err = await send_template(target, key)
        if ok:
            await event.edit(
                f"✅ Template <code>{key}</code> terkirim ke <code>{target}</code>",
                parse_mode='html'
            )
        else:
            await event.edit(
                f"❌ <b>Gagal kirim:</b>\n<code>{html.escape(str(err))}</code>",
                parse_mode='html'
            )


# =========================================================
# 2. AUTO WELCOME + LAPORAN
# =========================================================
@client.on(events.NewMessage(incoming=True))
async def auto_reply(event):
    if not (event.is_private and not event.out):
        return

    sender_id = event.sender_id

    if is_blocked(sender_id):
        log.info(f"[BLOCKED] Pesan dari {sender_id} diabaikan.")
        return

    if is_muted(sender_id):
        log.info(f"[MUTED] Pesan dari {sender_id} diterima (tanpa auto-reply).")
        return

    is_open = get_setting('is_store_open') == 'True'

    if not is_open:
        if not is_user_responded(sender_id):
            await event.reply(msg_closed())
            add_responded_user(sender_id)
        return

    if is_spamming(sender_id):
        return

    if not is_user_responded(sender_id):
        sender = await event.get_sender()
        await event.reply(msg_welcome())
        add_responded_user(sender_id)

        keyboard = [
            [Button.inline("🔗 Hubungkan", data=f"connect_{sender_id}")],
            [
                Button.inline("👤 Profil", data=f"profile_{sender_id}"),
                Button.inline("✅ Selesai", data=f"done_{sender_id}"),
            ],
        ]

        try:
            report_text = event.raw_text or "📎 [Media]"
            report_msg = await client.send_message(
                GROUP_ADMIN_ID,
                msg_report(sender, report_text),
                parse_mode='html',
                buttons=keyboard,
            )
            save_report_message(report_msg.id, sender_id)
            log.info(f"[REPORT] user={sender_id} msg_id={report_msg.id}")
        except Exception as e:
            log.error(f"[ERROR GRUP] {type(e).__name__}: {e}")


