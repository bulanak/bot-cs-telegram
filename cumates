# 3. HANDLE TOMBOL
# =========================================================
@client.on(events.CallbackQuery())
async def handle_callback(event):
    data = event.data.decode()

    # ── Connect ────────────────────────────────────────
    if data.startswith("connect_"):
        try:
            target_user_id = int(data.split("_", 1)[1])
        except (IndexError, ValueError):
            return await event.answer("⚠️ Data tidak valid.", alert=True)

        if is_blocked(target_user_id):
            return await event.answer("🚫 User diblokir.", alert=True)

        nama_aktif = get_setting('nama_admin')
        try:
            target_user = await client.get_entity(target_user_id)
        except Exception:
            target_user = None

        try:
            sent = await client.send_message(
                target_user_id,
                msg_connected(nama_aktif, user=target_user, user_id=target_user_id),
                parse_mode='html',
                buttons=keyboard_connected(target_user_id),
            )
            try:
                await client.pin_message(target_user_id, sent.id, notify=True)
            except Exception as pin_err:
                log.warning(f"[PIN] {pin_err}")
        except Exception as e:
            log.error(f"[ERROR SEND] {e}")
            return await event.answer("❌ Gagal menghubungi pelanggan.", alert=True)

        new_buttons = [[
            Button.inline("👤 Profil", data=f"profile_{target_user_id}"),
            Button.inline("✅ Selesai", data=f"done_{target_user_id}"),
        ]]
        await event.edit(
            text=event.message.text + f"\n\n✅ <b>STATUS:</b> Terhubung dengan <b>{nama_aktif}</b> (📌 di-pin).",
            buttons=new_buttons,
            parse_mode='html'
        )
        await event.answer(f"✅ Terhubung dengan {nama_aktif} & di-pin.")

    # ── Profil ─────────────────────────────────────────
    elif data.startswith("profile_"):
        try:
            target_user_id = int(data.split("_", 1)[1])
        except (IndexError, ValueError):
            return await event.answer("⚠️ Data tidak valid.", alert=True)
        try:
            user = await client.get_entity(target_user_id)
            uname = f"@{user.username}" if user.username else "Tidak tersedia"
            info = (
                f"👤 Profil Pelanggan\n"
                f"━━━━━━━━━━━━━━━━━\n"
                f"Nama     : {user.first_name or '-'}\n"
                f"Username : {uname}\n"
                f"User ID  : {user.id}"
            )
            await event.answer(info, alert=True)
        except Exception as e:
            log.error(f"[ERROR PROFILE] {e}")
            await event.answer("❌ Tidak bisa memuat profil.", alert=True)

    # ── Done (dari grup admin) ─────────────────────────
    elif data.startswith("done_"):
        await event.edit(
            text=event.message.text + "\n\n✅ <b>STATUS:</b> Percakapan ditandai selesai.",
            buttons=None,
            parse_mode='html'
        )
        await event.answer("✅ Percakapan ditandai selesai.")

    # ── Panggil admin (dari pelanggan) ─────────────────
    elif data.startswith("call_"):
        try:
            target_user_id = int(data.split("_", 1)[1])
        except (IndexError, ValueError):
            return await event.answer("⚠️ Data tidak valid.", alert=True)

        nama_aktif = get_setting('nama_admin')
        await event.answer("📞 Admin telah diberitahu, mohon tunggu ya.", alert=True)

        try:
            await client.send_message(
                GROUP_ADMIN_ID,
                f"🔔 <b>PANGGILAN PELANGGAN</b>\n\n"
                f"🆔 User ID: <code>{target_user_id}</code>\n"
                f"👩‍💼 Admin  : {nama_aktif}\n"
                f"💬 Pelanggan menekan tombol <b>Panggil Admin</b>.\n\n"
                f"Mohon segera direspons ya. 🙏",
                parse_mode='html'
            )
        except Exception as e:
            log.error(f"[CALL] {e}")

    # ── Akhiri sesi (dari pelanggan) ───────────────────
    elif data.startswith("endsession_"):
        try:
            target_user_id = int(data.split("_", 1)[1])
        except (IndexError, ValueError):
            return await event.answer("⚠️ Data tidak valid.", alert=True)

        try:
            await client.unpin_message(target_user_id)
        except Exception as e:
            log.warning(f"[UNPIN] {e}")

        await event.edit(
            "🙏 <b>TERIMA KASIH</b>\n\n"
            "Sesi CS ini telah berakhir.\n\n"
            "Kalau butuh bantuan lagi, silakan chat kami kembali ya, Kak. 😊\n\n"
            "<i>Semoga harimu menyenangkan! ✨</i>",
            buttons=None,
            parse_mode='html'
        )
        await event.answer("✅ Sesi diakhiri.")


