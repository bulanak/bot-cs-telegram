# HELPER TEMPLATE
# =========================================================
def get_template(key: str):
    with sqlite3.connect(DB_NAME) as conn:
        cur = conn.cursor()
        cur.execute("SELECT text, file_path FROM templates WHERE key = ?", (key,))
        return cur.fetchone()


def upsert_template_text(key: str, text: str):
    with sqlite3.connect(DB_NAME) as conn:
        cur = conn.cursor()
        cur.execute("""
            INSERT INTO templates (key, text) VALUES (?, ?)
            ON CONFLICT(key) DO UPDATE SET text = excluded.text
        """, (key, text))
        conn.commit()


def upsert_template_media(key: str, file_path: str):
    with sqlite3.connect(DB_NAME) as conn:
        cur = conn.cursor()
        cur.execute("""
            INSERT INTO templates (key, file_path) VALUES (?, ?)
            ON CONFLICT(key) DO UPDATE SET file_path = excluded.file_path
        """, (key, file_path))
        conn.commit()


def clear_template_media(key: str):
    with sqlite3.connect(DB_NAME) as conn:
        cur = conn.cursor()
        cur.execute("SELECT file_path FROM templates WHERE key = ?", (key,))
        row = cur.fetchone()
        if row and row[0]:
            try:
                os.remove(row[0])
            except FileNotFoundError:
                pass
        cur.execute("UPDATE templates SET file_path = NULL WHERE key = ?", (key,))
        conn.commit()


def delete_template(key: str):
    clear_template_media(key)
    with sqlite3.connect(DB_NAME) as conn:
        cur = conn.cursor()
        cur.execute("DELETE FROM templates WHERE key = ?", (key,))
        conn.commit()


def list_all_templates():
    with sqlite3.connect(DB_NAME) as conn:
        cur = conn.cursor()
        cur.execute("SELECT key, text, file_path FROM templates ORDER BY key")
        return cur.fetchall()


def save_report_message(message_id: int, user_id: int):
    with sqlite3.connect(DB_NAME) as conn:
        cur = conn.cursor()
        cur.execute(
            "INSERT OR REPLACE INTO report_messages (message_id, user_id) VALUES (?, ?)",
            (message_id, user_id),
        )
        conn.commit()


def get_user_from_report(message_id: int):
    with sqlite3.connect(DB_NAME) as conn:
        cur = conn.cursor()
        cur.execute("SELECT user_id FROM report_messages WHERE message_id = ?", (message_id,))
        row = cur.fetchone()
        return row[0] if row else None


async def send_template(target: int, key: str):
    if is_blocked(target):
        return False, "User sedang diblokir."
    tmpl = get_template(key)
    if not tmpl:
        return False, f"Template {key} belum ada."

    text_content, file_path = tmpl
    try:
        if file_path and os.path.exists(file_path):
            await client.send_file(target, file_path, caption=text_content or "")
        else:
            await client.send_message(target, text_content or "-")
        return True, None
    except Exception as e:
        log.error(f"[SEND TEMPLATE {key}] {type(e).__name__}: {e}")
        return False, f"{type(e).__name__}: {e}"


# =========================================================
# HELPER USER
# =========================================================
_memory_users: set[int] = set()
_last_message_time: dict[int, float] = {}
_muted_cache: set[int] = set()
_blocked_cache: set[int] = set()


def is_user_responded(user_id: int) -> bool:
    if user_id in _memory_users:
        return True
    with sqlite3.connect(DB_NAME) as conn:
        cur = conn.cursor()
        cur.execute("SELECT 1 FROM responded_users WHERE user_id = ?", (user_id,))
        found = cur.fetchone() is not None
    if found:
        _memory_users.add(user_id)
    return found


def add_responded_user(user_id: int):
    _memory_users.add(user_id)
    with sqlite3.connect(DB_NAME) as conn:
        cur = conn.cursor()
        cur.execute("INSERT OR IGNORE INTO responded_users (user_id) VALUES (?)", (user_id,))
        conn.commit()


def is_spamming(user_id: int) -> bool:
    now = time.time()
    last = _last_message_time.get(user_id, 0)
    if now - last < SPAM_COOLDOWN:
        return True
    _last_message_time[user_id] = now
    return False


def _count_users() -> int:
    with sqlite3.connect(DB_NAME) as conn:
        cur = conn.cursor()
        cur.execute("SELECT COUNT(*) FROM responded_users")
        return cur.fetchone()[0]


# =========================================================
# HELPER: MUTE / BLOCK
# =========================================================
def is_muted(user_id: int) -> bool:
    if user_id in _muted_cache:
        return True
    with sqlite3.connect(DB_NAME) as conn:
        cur = conn.cursor()
        cur.execute("SELECT 1 FROM muted_users WHERE user_id = ?", (user_id,))
        found = cur.fetchone() is not None
    if found:
        _muted_cache.add(user_id)
    return found


def is_blocked(user_id: int) -> bool:
    if user_id in _blocked_cache:
        return True
    with sqlite3.connect(DB_NAME) as conn:
        cur = conn.cursor()
        cur.execute("SELECT 1 FROM blocked_users WHERE user_id = ?", (user_id,))
        found = cur.fetchone() is not None
    if found:
        _blocked_cache.add(user_id)
    return found


def mute_user(user_id: int):
    _muted_cache.add(user_id)
    with sqlite3.connect(DB_NAME) as conn:
        cur = conn.cursor()
        cur.execute("INSERT OR IGNORE INTO muted_users (user_id) VALUES (?)", (user_id,))
        conn.commit()


def unmute_user(user_id: int):
    _muted_cache.discard(user_id)
    with sqlite3.connect(DB_NAME) as conn:
        cur = conn.cursor()
        cur.execute("DELETE FROM muted_users WHERE user_id = ?", (user_id,))
        conn.commit()


def block_user(user_id: int, reason: str = ""):
    _blocked_cache.add(user_id)
    with sqlite3.connect(DB_NAME) as conn:
        cur = conn.cursor()
        cur.execute(
            "INSERT OR REPLACE INTO blocked_users (user_id, reason) VALUES (?, ?)",
            (user_id, reason),
        )
        conn.commit()


def unblock_user(user_id: int):
    _blocked_cache.discard(user_id)
    with sqlite3.connect(DB_NAME) as conn:
        cur = conn.cursor()
        cur.execute("DELETE FROM blocked_users WHERE user_id = ?", (user_id,))
        conn.commit()


def list_muted() -> list:
    with sqlite3.connect(DB_NAME) as conn:
        cur = conn.cursor()
        cur.execute("SELECT user_id FROM muted_users ORDER BY created_at DESC")
        return [r[0] for r in cur.fetchall()]


def list_blocked() -> list:
    with sqlite3.connect(DB_NAME) as conn:
        cur = conn.cursor()
        cur.execute("SELECT user_id, reason FROM blocked_users ORDER BY created_at DESC")
        return cur.fetchall()


