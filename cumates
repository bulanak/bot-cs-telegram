_last_choice: dict[str, str] = {}


def _pick(variants: list, key: str) -> str:
    if len(variants) == 1:
        return variants[0]
    prev = _last_choice.get(key)
    choices = [v for v in variants if v != prev] or variants
    chosen = random.choice(choices)
    _last_choice[key] = chosen
    return chosen


