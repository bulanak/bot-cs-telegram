def delete_faq(keyword: str) -> bool:
    with sqlite3.connect(DB_NAME) as conn:
        cur = conn.cursor()
        cur.execute("DELETE FROM faq WHERE keyword = ?", (keyword.strip().lower(),))
        deleted = cur.rowcount > 0
        conn.commit()
        return deleted

def list_faq():
    with sqlite3.connect(DB_NAME) as conn:
        cur = conn.cursor()
        cur.execute("SELECT keyword, response, hit_count FROM faq ORDER BY hit_count DESC, keyword")
        return cur.fetchall()

def count_faq() -> int:
    with sqlite3.connect(DB_NAME) as conn:
        cur = conn.cursor()
        cur.execute("SELECT COUNT(*) FROM faq")
        return cur.fetchone()[0]

_last_faq_time: dict = {}

def check_faq(user_id: int, text: str):
    now = time.time()
    if now - _last_faq_time.get(user_id, 0) < FAQ_COOLDOWN:
        return None
    if not text: return None
    text_lower = text.lower()
    with sqlite3.connect(DB_NAME) as conn:
        cur = conn.cursor()
        cur.execute("SELECT keyword, response FROM faq ORDER BY LENGTH(keyword) DESC")
        for keyword, response in cur.fetchall():
            if keyword in text_lower:
                cur.execute("UPDATE faq SET hit_count = hit_count + 1 WHERE keyword = ?", (keyword,))
                conn.commit()
                _last_faq_time[user_id] = now
                return response
    return None

