        await event.edit(f"📢 <b>KONFIRMASI BROADCAST</b>\n━━━━━━━━━━━━━━━━━━━━━━\n👥 Target: <b>{stats['users']} pelanggan</b>\n━━━━━━━━━━━━━━━━━━━━━━\n<blockquote>{preview}</blockquote>\n━━━━━━━━━━━━━━━━━━━━━━\n<i>Klik tombol untuk konfirmasi.</i>", buttons=[[Button.inline("✅ Kirim", data="bcast_confirm"), Button.inline("❌ Batal", data="bcast_cancel")]], parse_mode='html')
        _pending_broadcast[event.chat_id] = content

    elif re.match(r"^\.jam\s+(\d{2}:\d{2})\s*-\s*(\d{2}:\d{2})$", text):
        m = re.match(r"^\.jam\s+(\d{2}:\d{2})\s*-\s*(\d{2}:\d{2})$", text)
        start, end = m.group(1), m.group(2)
        update_setting('work_start', start)
        update_setting('work_end', end)
        await event.edit(f"⏰ <b>JAM OPERASIONAL DISET</b>\n\n🌅 Buka : <b>{start}</b>\n🌙 Tutup: <b>{end}</b>\n\n<i>Aktifkan auto: <code>.auto on</code></i>", parse_mode='html')

    elif text in ('.auto on', '.auto off'):
        val = 'True' if text.endswith('on') else 'False'
        update_setting('auto_hours', val)
        if val == 'True': await event.edit(f"✅ <b>AUTO HOURS ON</b>\n\nCS akan otomatis buka {get_setting('work_start')} dan tutup {get_setting('work_end')}.", parse_mode='html')
        else: await event.edit("❌ <b>AUTO HOURS OFF</b>\n\nBuka/tutup manual via <code>.open</code> / <code>.close</code>", parse_mode='html')

# =========================================================
# AUTO WELCOME + LAPORAN
# =========================================================
@client.on(events.NewMessage(incoming=True))
async def auto_reply(event):
    if not (event.is_private and not event.out): return
    sender_id = event.sender_id
    check_auto_status()

    if is_blocked(sender_id):
        log.info(f"[BLOCKED] {sender_id}"); return
    if is_muted(sender_id):
        log.info(f"[MUTED] {sender_id}"); return

    is_open = get_setting('is_store_open') == 'True'
    if not is_open:
        if not is_spamming(sender_id):
            try: await event.reply(msg_closed())
            except Exception as e: log.error(f"[CLOSED] {e}")
        return

    if is_spamming(sender_id): return

    text_in = event.raw_text or ""
    if not is_user_responded(sender_id):
        sender = await event.get_sender()
        try: await event.reply(msg_welcome())
        except Exception as e: log.error(f"[WELCOME] {e}")
        add_responded_user(sender_id)
        try:
            report_msg = await client.send_message(GROUP_ADMIN_ID, msg_report(sender, text_in), parse_mode='html', buttons=keyboard_report(sender_id))
            save_report_message(report_msg.id, sender_id)
            log.info(f"[REPORT] user={sender_id} msg_id={report_msg.id}")
        except Exception as e: log.error(f"[ERROR GRUP] {type(e).__name__}: {e}")

    faq_resp = check_faq(sender_id, text_in)
    if faq_resp:
        try:
            await asyncio.sleep(0.8)
            await event.reply(faq_resp)
        except Exception as e: log.error(f"[FAQ] {e}")

# =========================================================
# HANDLE TOMBOL
# =========================================================
_pending_broadcast: dict = {}

@client.on(events.CallbackQuery())
async def handle_callback(event):
    data = event.data.decode()

    if data.startswith("connect_"):
        try: uid = int(data.split("_", 1)[1])
        except: return await event.answer("⚠️ Data tidak valid.", alert=True)
        if is_blocked(uid): return await event.answer("🚫 User diblokir.", alert=True)
        nama = get_setting('nama_admin')
        try: target_user = await client.get_entity(uid)
        except: target_user = None
        try:
            sent = await client.send_message(uid, msg_connected(nama, user=target_user, user_id=uid), parse_mode='html', buttons=keyboard_connected(uid))
            try: await client.pin_message(uid, sent.id, notify=True)
            except Exception as e: log.warning(f"[PIN] {e}")
        except Exception as e:
            log.error(f"[ERROR SEND] {e}")
            return await event.answer("❌ Gagal menghubungi pelanggan.", alert=True)
        await event.edit(text=event.message.text + f"\n\n✅ <b>STATUS:</b> Terhubung dengan <b>{nama}</b> (📌 di-pin).", buttons=[[Button.inline("👤 Profil", data=f"profile_{uid}"), Button.inline("📝 Note", data=f"note_{uid}"), Button.inline("✅ Selesai", data=f"done_{uid}")]], parse_mode='html')
        await event.answer(f"✅ Terhubung dengan {nama} & di-pin.")

    elif data.startswith("profile_"):
        try: uid = int(data.split("_", 1)[1])
        except: return await event.answer("⚠️ Data tidak valid.", alert=True)
        try:
            user = await client.get_entity(uid)
            uname = f"@{user.username}" if user.username else "-"
            notes = get_notes(uid)
            rating = get_user_rating(uid)
            rating_str = f"{'⭐' * rating[0]} ({rating[0]}/5)" if rating else "Belum ada"
            info = f"👤 Profil Pelanggan\n━━━━━━━━━━━━━━━━━\nNama     : {user.first_name or '-'}\nUsername : {uname}\nUser ID  : {user.id}\nNotes    : {len(notes)} catatan\nRating   : {rating_str}"
            await event.answer(info, alert=True)
        except Exception as e:
            log.error(f"[PROFILE] {e}")
            await event.answer("❌ Tidak bisa memuat profil.", alert=True)

    elif data.startswith("note_"):
        try: uid = int(data.split("_", 1)[1])
        except: return await event.answer("⚠️ Data tidak valid.", alert=True)
        notes = get_notes(uid)
        if not notes: return await event.answer(f"📭 Belum ada catatan untuk user ini.\nTambah: .catat {uid} teks", alert=True)
        text = f"📝 Catatan ({len(notes)}):\n\n"
        for note, created in notes[:5]: text += f"• {created[:16]}\n  {note[:100]}\n\n"
        await event.answer(text, alert=True)

    elif data.startswith("done_"):
        await event.edit(text=event.message.text + "\n\n✅ <b>STATUS:</b> Percakapan ditandai selesai.", buttons=None, parse_mode='html')
        await event.answer("✅ Ditandai selesai.")

    elif data.startswith("call_"):
        try: uid = int(data.split("_", 1)[1])
        except: return await event.answer("⚠️ Data tidak valid.", alert=True)
        nama = get_setting('nama_admin')
        await event.answer("📞 Admin telah diberitahu.", alert=True)
        try: await client.send_message(GROUP_ADMIN_ID, f"🔔 <b>PANGGILAN PELANGGAN</b>\n\n🆔 User ID: <code>{uid}</code>\n👩‍💼 Admin  : {nama}\n💬 Pelanggan menekan tombol <b>Panggil Admin</b>.\n\nMohon segera direspons ya. 🙏", parse_mode='html')
        except Exception as e: log.error(f"[CALL] {e}")

    elif data.startswith("endsession_"):
        try: uid = int(data.split("_", 1)[1])
        except: return await event.answer("⚠️ Data tidak valid.", alert=True)
        try: await client.unpin_message(uid)
        except Exception as e: log.warning(f"[UNPIN] {e}")
        await event.edit(msg_ending(), buttons=None, parse_mode='html')
        await event.answer("✅ Sesi diakhiri.")
        await send_rating_prompt(uid)

    elif data.startswith("rate_"):
        parts = data.split("_")
        if len(parts) < 3: return await event.answer("⚠️ Data tidak valid.", alert=True)
        try: stars, uid = int(parts[1]), int(parts[2])
        except: return await event.answer("⚠️ Data tidak valid.", alert=True)
        if not (1 <= stars <= 5): return await event.answer("⚠️ Rating harus 1-5.", alert=True)
        add_rating(uid, stars)
        await event.edit(f"{'⭐' * stars}\n\n<b>TERIMA KASIH ATAS RATINGNYA! 🙏</b>\n\nKakak memberi <b>{stars}/5 bintang</b>.\nMasukan Kakak sangat berarti untuk kami. 💫\n\n<i>Sampai jumpa lagi! 👋</i>", buttons=None, parse_mode='html')
        await event.answer(f"✅ Rating {stars}/5 tersimpan!")
        try: await client.send_message(GROUP_ADMIN_ID, f"⭐ <b>RATING BARU MASUK</b>\n\n🆔 User: <code>{uid}</code>\n⭐ Rating: {'⭐' * stars} ({stars}/5)", parse_mode='html')
        except Exception as e: log.warning(f"[RATING NOTIFY] {e}")

    elif data == "bcast_confirm":
        content = _pending_broadcast.pop(event.chat_id, None)
        if not content: return await event.answer("⚠️ Tidak ada broadcast pending.", alert=True)
        await event.edit("📢 <b>Mengirim broadcast...</b>", parse_mode='html')
        success, failed = await broadcast_message(content)
        await event.edit(f"📢 <b>BROADCAST SELESAI</b>\n━━━━━━━━━━━━━━━━━━━━━━\n✅ Sukses : {success}\n❌ Gagal  : {failed}\n━━━━━━━━━━━━━━━━━━━━━━", parse_mode='html')
        await event.answer(f"✅ {success} terkirim, {failed} gagal.")

    elif data == "bcast_cancel":
        _pending_broadcast.pop(event.chat_id, None)
        await event.edit("❌ <b>Broadcast dibatalkan.</b>", parse_mode='html')
        await event.answer("Dibatalkan.")

