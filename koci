async def send_template(target: int, key: str):
    if is_blocked(target): return False, "User sedang diblokir."
    tmpl = get_template(key)
    if not tmpl: return False, f"Template {key} belum ada."
    text_content, file_path = tmpl
    try:
        if file_path and os.path.exists(file_path): await client.send_file(target, file_path, caption=text_content or "")
        else: await client.send_message(target, text_content or "-")
        return True, None
    except Exception as e:
        log.error(f"[SEND TEMPLATE {key}] {type(e).__name__}: {e}")
        return False, f"{type(e).__name__}: {e}"

async def send_rating_prompt(user_id: int):
    if get_setting('rating_enabled', 'True') != 'True': return
    try: await client.send_message(user_id, msg_rating_prompt(), buttons=keyboard_rating(user_id), parse_mode='html')
    except Exception as e: log.warning(f"[RATING PROMPT] {e}")

async def broadcast_message(text: str, exclude: set = None):
    exclude = exclude or set()
    with sqlite3.connect(DB_NAME) as conn:
        cur = conn.cursor()
        cur.execute("SELECT user_id FROM responded_users")
        users = [r[0] for r in cur.fetchall() if r[0] not in exclude]
    success, failed = 0, 0
    for uid in users:
        if is_blocked(uid):
            failed += 1
            continue
        try:
            await client.send_message(uid, text, parse_mode='html')
            success += 1
            await asyncio.sleep(0.15)
        except Exception: failed += 1
    return success, failed

async def search_users(query: str, limit: int = 10):
    results = []
    query_low = query.lower()
    with sqlite3.connect(DB_NAME) as conn:
        cur = conn.cursor()
        cur.execute("SELECT user_id FROM responded_users")
        all_users = [r[0] for r in cur.fetchall()]
    for uid in all_users:
        try:
            user = await client.get_entity(uid)
            name = (user.first_name or '').lower()
            uname = (user.username or '').lower()
            if query_low in name or query_low in uname or query in str(uid):
                results.append(user)
                if len(results) >= limit: break
        except Exception: continue
    return results

