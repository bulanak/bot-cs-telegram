def upsert_template_text(key: str, text: str):
    with sqlite3.connect(DB_NAME) as conn:
        cur = conn.cursor()
        cur.execute("INSERT INTO templates (key, text) VALUES (?, ?) ON CONFLICT(key) DO UPDATE SET text = excluded.text", (key, text))
        conn.commit()

def upsert_template_media(key: str, file_path: str):
    with sqlite3.connect(DB_NAME) as conn:
        cur = conn.cursor()
        cur.execute("INSERT INTO templates (key, file_path) VALUES (?, ?) ON CONFLICT(key) DO UPDATE SET file_path = excluded.file_path", (key, file_path))
        conn.commit()

def clear_template_media(key: str):
    with sqlite3.connect(DB_NAME) as conn:
        cur = conn.cursor()
        cur.execute("SELECT file_path FROM templates WHERE key = ?", (key,))
        row = cur.fetchone()
        if row and row[0]:
            try: os.remove(row[0])
            except FileNotFoundError: pass
        cur.execute("UPDATE templates SET file_path = NULL WHERE key = ?", (key,))
        conn.commit()

def delete_template(key: str):
    clear_template_media(key)
