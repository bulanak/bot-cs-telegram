def init_db():
    with sqlite3.connect(DB_NAME) as conn:
        cur = conn.cursor()
        cur.execute("CREATE TABLE IF NOT EXISTS settings (key TEXT PRIMARY KEY, value TEXT)")
        cur.execute("CREATE TABLE IF NOT EXISTS responded_users (user_id INTEGER PRIMARY KEY)")
        cur.execute("CREATE TABLE IF NOT EXISTS templates (key TEXT PRIMARY KEY, text TEXT, file_path TEXT)")
        cur.execute("CREATE TABLE IF NOT EXISTS report_messages (message_id INTEGER PRIMARY KEY, user_id INTEGER, created_at DATETIME DEFAULT CURRENT_TIMESTAMP)")
        cur.execute("CREATE TABLE IF NOT EXISTS muted_users (user_id INTEGER PRIMARY KEY, created_at DATETIME DEFAULT CURRENT_TIMESTAMP)")
        cur.execute("CREATE TABLE IF NOT EXISTS blocked_users (user_id INTEGER PRIMARY KEY, reason TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP)")
        cur.execute("CREATE TABLE IF NOT EXISTS faq (keyword TEXT PRIMARY KEY, response TEXT NOT NULL, hit_count INTEGER DEFAULT 0, created_at DATETIME DEFAULT CURRENT_TIMESTAMP)")
        cur.execute("CREATE TABLE IF NOT EXISTS notes (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER, note TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP)")
        cur.execute("CREATE TABLE IF NOT EXISTS ratings (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER, rating INTEGER, comment TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP)")

        defaults = {
            'nama_admin': 'Siti',
            'is_store_open': 'True',
            'work_start': '08:00',
            'work_end': '21:00',
            'auto_hours': 'False',
            'rating_enabled': 'True',
            'welcome_hint': 'True',
        }
        for k, v in defaults.items():
            cur.execute("INSERT OR IGNORE INTO settings (key, value) VALUES (?, ?)", (k, v))
        conn.commit()

def get_setting(key, default=None):
    with sqlite3.connect(DB_NAME) as conn:
        cur = conn.cursor()
        cur.execute("SELECT value FROM settings WHERE key = ?", (key,))
        row = cur.fetchone()
        return row[0] if row else default

def update_setting(key, value):
    with sqlite3.connect(DB_NAME) as conn:
        cur = conn.cursor()
        cur.execute("INSERT OR REPLACE INTO settings (key, value) VALUES (?, ?)", (key, str(value)))
        conn.commit()

# =========================================================
# WORKING HOURS
# =========================================================
def is_within_working_hours() -> bool:
    start = get_setting('work_start', '08:00')
    end = get_setting('work_end', '21:00')
    now = datetime.now().strftime('%H:%M')
    return start <= now <= end

def check_auto_status():
    if get_setting('auto_hours', 'False') != 'True':
        return False
    should_open = is_within_working_hours()
    current = get_setting('is_store_open') == 'True'
    if should_open != current:
        update_setting('is_store_open', 'True' if should_open else 'False')
        log.info(f"[AUTO] CS auto {'OPEN' if should_open else 'CLOSE'}")
        return True
    return False

