import sqlite3
import time
from telethon import TelegramClient, events, Button

# ---------------------------------------------------------
# KONFIGURASI AKUN & API
# ---------------------------------------------------------
API_ID = 35443397
API_HASH = "4888086e2b51f0fb989d5eb419e468"

client = TelegramClient('sesi_cs_pribadi', API_ID, API_HASH)
GROUP_ADMIN_ID = -5470251538 
SPAM_COOLDOWN = 30             

# ---------------------------------------------------------
# SETUP DATABASE SQLite
# ---------------------------------------------------------
def init_db():
    conn = sqlite3.connect('bot_cs_data.db')
    cursor = conn.cursor()
    
    # Tabel untuk menyimpan setting (Nama Admin & Status Toko)
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS settings (
            key TEXT PRIMARY KEY,
            value TEXT
        )
    ''')
    
    # Tabel untuk mencatat pelanggan yang sudah di-welcome
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS responded_users (
            user_id INTEGER PRIMARY KEY
        )
    ''')
    
    # Inisialisasi data default jika belum ada di database
    cursor.execute("INSERT OR IGNORE INTO settings (key, value) VALUES ('nama_admin', 'Siti')")
    cursor.execute("INSERT OR IGNORE INTO settings (key, value) VALUES ('is_store_open', 'True')")
    

		    conn.commit()
    conn.close()

# Fungsi helper untuk mengambil setting dari database
def get_setting(key):
    conn = sqlite3.connect('bot_cs_data.db')
    cursor = conn.cursor()
    cursor.execute("SELECT value FROM settings WHERE key = ?", (key,))
    row = cursor.fetchone()
    conn.close()
    return row[0] if row else None

# Fungsi helper untuk mengubah setting di database
def update_setting(key, value):
    conn = sqlite3.connect('bot_cs_data.db')
    cursor = conn.cursor()
    cursor.execute("UPDATE settings SET value = ? WHERE key = ?", (value, key))
    conn.commit()
    conn.close()

# Fungsi cek apakah user sudah pernah disapa
fn_memory_users = set() # Cache sementara agar tidak terus-menerus query ke file
def is_user_responded(user_id):
    if user_id in fn_memory_users:
        return True
    conn = sqlite3.connect('bot_cs_data.db')
    cursor = conn.cursor()
    cursor.execute("SELECT 1 FROM responded_users WHERE user_id = ?", (user_id,))
    row = cursor.fetchone()
    conn.close()
    if row:
        fn_memory_users.add(user_id)
        return True
    return False

# Fungsi simpan user yang sudah disapa ke database
def add_responded_user(user_id):
    fn_memory_users.add(user_id)
    conn = sqlite3.connect('bot_cs_data.db')
    cursor = conn.cursor()
    cursor.execute("INSERT OR IGNORE INTO responded_users (user_id) VALUES (?)", (user_id,))
    conn.commit()
    conn.close()

# Variabel Anti-Spam (di RAM)
last_message_time = {}

# ---------------------------------------------------------
# 1. FITUR COMMAND TELEGRAM (ADMIN, OPEN, CLOSE, STATUS)
# ---------------------------------------------------------
@client.on(events.NewMessage(outgoing=True))
async def owner_commands(event):
    text = event.raw_text.strip()

    # Perintah ganti nama admin (Contoh: .admin Ayu)
    if text.startswith('.admin '):
        nama_baru = text.split('.admin ', 1)[1].strip()
        if nama_baru:
            update_setting('nama_admin', nama_baru)
            await event.edit(f"✅ **BERHASIL:** Nama admin CS sekarang diubah menjadi **{nama_baru}** (tersimpan di database).")
            print(f"[CONFIG] Nama admin diubah menjadi: {nama_baru}")
        else:
            await event.edit("⚠️ **GAGAL:** Format salah. Gunakan format `.admin NamaAdmin`")

    # Perintah membuka toko
    elif text == '.open':
        update_setting('is_store_open', 'True')
        await event.edit("🟢 **STATUS CS:** Berhasil diubah menjadi **BUKA (OPEN)**.")
        print("[STATUS] Toko dibuka oleh owner.")

    # Perintah menutup toko
    elif text == '.close':
        update_setting('is_store_open', 'False')
        await event.edit("🔴 **STATUS CS:** Berhasil diubah menjadi **TUTUP (CLOSE)**.")
        print("[STATUS] Toko ditutup oleh owner.")

    # Perintah melihat status saat ini
    elif text == '.status':
        nama_aktif = get_setting('nama_admin')
        buka_tutup = get_setting('is_store_open')
        status_toko = "🟢 BUKA" if buka_tutup == 'True' else "🔴 TUTUP"
        await event.edit(
            f"ℹ️ **STATUS CS PINTARNYA ID**\n\n"
            f"• **Nama Admin Aktif:** {nama_aktif}\n"
            f"• **Status Toko:** {status_toko}"
        )

# ---------------------------------------------------------
# 2. PESAN WELCOME & LAPORAN KE GRUP
# ---------------------------------------------------------
@client.on(events.NewMessage(incoming=True))
async def auto_reply(event):
    if event.is_private and not event.out:
        sender_id = event.sender_id
        current_time = time.time()
        
        is_open = get_setting('is_store_open') == 'True'
        
        # JIKA TOKO TUTUP
        if not is_open:
            if not is_user_responded(sender_id):
                pesan_tutup = (
                    "Halo! 👋\n\n"
                    "Mohon maaf, saat ini layanan Customer Service kami sedang **TUTUP** atau beristirahat.\n"
                    "Pesan Anda telah kami terima dan akan segera dibalas saat jam operasional dibuka kembali. Terima kasih! 🙏"
                )
                await event.reply(pesan_tutup)
                add_responded_user(sender_id)
            return

        # JIKA TOKO BUKA (Anti-Spam Check)
        if sender_id in last_message_time:
            if current_time - last_message_time[sender_id] < SPAM_COOLDOWN:
                return
        last_message_time[sender_id] = current_time
        
        # Jika pelanggan belum pernah disapa sebelumnya di database
        if not is_user_responded(sender_id):
            sender = await event.get_sender()
            
            # Pesan Welcome
            pesan_welcome = (
                "Halo! 👋\n\n"
                "Terima kasih telah menghubungi layanan kami.\n"
                "Pesan Anda telah kami terima. Mohon tunggu sebentar ya, admin kami akan segera menghubungkan Anda! 🙏"
            )
            await event.reply(pesan_welcome)
            add_responded_user(sender_id)
            
            # Kirim Laporan ke Grup Admin
            username_info = f"@{sender.username}" if sender.username else "Tidak ada username"
            laporan_grup = (
                f"🚨 **ADA PELANGGAN BARU MASUK!**\n\n"
                f"• **Nama:** {sender.first_name}\n"
                f"• **Username:** {username_info}\n"
                f"• **Pesan Masuk:** _{event.raw_text}_\n\n"
                f"Klik tombol di bawah ini untuk menghubungkan pelanggan:"
            )
            
            # Perbaikan tombol menggunakan Button.inline dari Telethon
            keyboard = [
                [Button.inline("🔗 Hubungkan Pelanggan Ini", data=f"connect_{sender_id}")]
            ]
            
            try:
                await client.send_message(
                    GROUP_ADMIN_ID, 
                    laporan_grup, 
                    parse_mode='markdown',
                    buttons=keyboard
                )
            except Exception as e:
                print(f"[ERROR GRUP] Gagal kirim ke grup: {e}")

# ---------------------------------------------------------
# 3. EVENT KETIKA ADMIN KLIK TOMBOL "HUBUNGKAN" DI GRUP
# ---------------------------------------------------------
@client.on(events.CallbackQuery(pattern=b"connect_"))
async def handle_admin_click(event):
    data_bytes = event.data
    target_user_id = int(data_bytes.decode('utf-8').split("_")[1])
    
    nama_aktif = get_setting('nama_admin')
    
    # Kirim pesan terhubung dengan Nama Admin aktif dari database
    pesan_terhubung = f"Saat ini kamu terhubung dengan admin customer service kami - {nama_aktif}"
    await client.send_message(target_user_id, pesan_terhubung)
    
    # Update tampilan di grup admin
    await event.edit(
        text=event.message.text + f"\n\n✅ **STATUS:** Berhasil terhubung dengan Admin ({nama_aktif}).",
        buttons=None
    )

# ---------------------------------------------------------
# MAIN RUNNER
# ---------------------------------------------------------
def main():
    # Inisialisasi database sebelum bot jalan
    init_db()
    print("--------------------------------------------------")
    print("  Userbot CS dengan SQLite Database Aktif!        ")
    print("--------------------------------------------------")
    client.start()
    client.run_until_disconnected()

if __name__ == '__main__':
    main()

